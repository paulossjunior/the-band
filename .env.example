# Exemplo de variáveis de ambiente do The Band.
#
# Copie para `.env` e preencha com valores locais:
#
#     cp .env.example .env
#
# `.env` está no `.gitignore` e NUNCA deve ser versionado.
#
# ATENÇÃO: este repositório é PÚBLICO. Nenhum valor real de credencial pode aparecer neste
# arquivo. Todo valor abaixo é um marcador de posição, não um segredo utilizável.
# A verificação automática de segurança reprova a proposta de mudança que introduzir
# credencial versionada.

# ------------------------------------------------------------------------------
# Banco de dados
# ------------------------------------------------------------------------------

# Obrigatória. A inicialização falha nomeando esta variável se ela estiver ausente.
DATABASE_URL=ecto://postgres:postgres@localhost:5432/the_band_dev

# Usadas apenas pelo `compose.yaml` para subir o PostgreSQL local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=the_band_dev
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------

# Obrigatória. Gere um valor próprio com:
#
#     mix phx.gen.secret
#
# Não use o marcador abaixo. Ele existe apenas para documentar o formato esperado
# (64 caracteres ou mais).
SECRET_KEY_BASE=GERE_O_SEU_COM_mix_phx_gen_secret_______________________________

# Obrigatória em produção. Em desenvolvimento o padrão é `localhost`.
PHX_HOST=localhost

# Porta em que a aplicação atende.
PORT=4000

# ------------------------------------------------------------------------------
# Operação
# ------------------------------------------------------------------------------

# Segredo compartilhado que libera a verificação de saúde detalhada por componente.
# Não é usuário, não é papel e não implica sistema de autenticação.
#
# Torna-se obrigatória junto com o endereço de verificação detalhada (issue #3). Quando
# não estiver configurada, o caminho detalhado RECUSA todo acesso — nunca libera.
#
# Gere um valor próprio com:
#
#     mix phx.gen.secret 48
THE_BAND_OPERATOR_SECRET=GERE_O_SEU_COM_mix_phx_gen_secret_48____________
